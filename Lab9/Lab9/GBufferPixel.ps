Texture2D baseColorTexture : register(t0);
Texture2D normalMap : register(t1);
Texture2D metallicRoughnessTexture : register(t2);
Texture2D emissiveTexture : register(t3);
SamplerState samplerState : register(s0);

static const float MIN_ROUGHNESS = 0.045f;

cbuffer MaterialBuffer : register(b3)
{
    float4 Surface;
    float4 Albedo;
    float4 DebugView;
    float4 Emissive;
    float4 Extra;
    float4 AlphaParams;
    float4 TextureFlags;
};

struct PS_INPUT
{
    float4 Pos : SV_POSITION;
    float3 WorldPos : TEXCOORD0;
    float3 Normal : TEXCOORD1;
    float2 TexCoord : TEXCOORD2;
    float3 Tangent : TEXCOORD3;
    float3 Bitangent : TEXCOORD4;
};

struct PS_OUTPUT
{
    float4 Albedo : SV_TARGET0;
    float4 Material : SV_TARGET1;
    float4 Normal : SV_TARGET2;
    float4 Emissive : SV_TARGET3;
};

float3 CalculateNormalFromMap(float3 normal, float3 tangent, float3 bitangent, float2 texCoord, float normalStrength)
{
    float3 mapNormal = normalMap.Sample(samplerState, texCoord).xyz * 2.0f - 1.0f;
    mapNormal.xy *= normalStrength;
    mapNormal.z = sqrt(saturate(1.0f - dot(mapNormal.xy, mapNormal.xy)));
    float3x3 TBN = float3x3(normalize(tangent), normalize(bitangent), normalize(normal));
    return normalize(mul(mapNormal, TBN));
}

PS_OUTPUT main(PS_INPUT input)
{
    float hasBaseColorTexture = step(0.5f, TextureFlags.x);
    float hasNormalTexture = step(0.5f, TextureFlags.y);
    float hasMetallicRoughnessTexture = step(0.5f, TextureFlags.z);
    float hasEmissiveTexture = step(0.5f, TextureFlags.w);

    float4 baseSample = baseColorTexture.Sample(samplerState, input.TexCoord);
    float4 baseColor = float4(saturate(Albedo.rgb), AlphaParams.y);
    baseColor = lerp(baseColor, baseColor * baseSample, hasBaseColorTexture);

    if (AlphaParams.w > 0.5f && baseColor.a < AlphaParams.z)
    {
        discard;
    }

    float metallic = saturate(Surface.x);
    float roughness = max(saturate(Surface.y), MIN_ROUGHNESS);
    float ao = saturate(Surface.z);

    float4 metallicRoughnessSample = metallicRoughnessTexture.Sample(samplerState, input.TexCoord);
    metallic = lerp(metallic, saturate(metallic * metallicRoughnessSample.b), hasMetallicRoughnessTexture);
    roughness = lerp(roughness, max(saturate(roughness * metallicRoughnessSample.g), MIN_ROUGHNESS), hasMetallicRoughnessTexture);

    float3 normal = normalize(input.Normal);
    if (hasNormalTexture > 0.5f && Surface.w > 0.0f)
    {
        normal = CalculateNormalFromMap(
            input.Normal,
            input.Tangent,
            input.Bitangent,
            input.TexCoord,
            Surface.w
        );
    }

    float3 emissiveSample = emissiveTexture.Sample(samplerState, input.TexCoord).rgb;
    float3 emissive = lerp(saturate(Emissive.rgb), emissiveSample * Emissive.rgb, hasEmissiveTexture);

    PS_OUTPUT output;
    output.Albedo = float4(saturate(baseColor.rgb), baseColor.a);
    output.Material = float4(0.04f, metallic, roughness, ao);
    output.Normal = float4(normal * 0.5f + 0.5f, saturate(Extra.w));
    output.Emissive = float4(emissive, max(max(emissive.r, emissive.g), emissive.b));
    return output;
}
